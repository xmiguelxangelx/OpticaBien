@{
    ViewData["Title"] = "Panel del Empleado";
}

<div class="container mt-5">

    <!-- Encabezado -->
    <div class="text-center mb-4">
        <h2 class="fw-bold display-6 text-primary">Panel del Empleado</h2>
        <p class="text-muted">
            Gestión operativa diaria · @DateTime.Now.ToString("dd/MM/yyyy")
        </p>
    </div>

    <!-- Tarjetas resumen -->
    <div class="row g-4 mb-4 justify-content-center">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center py-3">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Ventas de hoy</h6>
                    <p class="fs-3 fw-bold mb-0">0</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center py-3">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Citas de hoy</h6>
                    <p class="fs-3 fw-bold mb-0">0</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center py-3">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Clientes atendidos</h6>
                    <p class="fs-3 fw-bold mb-0">0</p>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center py-3">
                <div class="card-body">
                    <h6 class="text-muted mb-1">Productos bajos en stock</h6>
                    <p class="fs-3 fw-bold mb-0">0</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos principales -->
    <div class="row g-4 mb-4">

        <!-- Ventas -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-2">Gestión de Ventas</h5>
                        <p class="text-muted mb-3">
                            Registre ventas, genere facturas y consulte el historial de compras de los clientes.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a asp-controller="Venta" asp-action="Index" class="btn btn-primary rounded-pill">
                            Ir a Ventas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventario -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-2">Inventario</h5>
                        <p class="text-muted mb-3">
                            Revise existencias, actualice stock y controle productos próximos a agotarse.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a asp-controller="Inventario" asp-action="Index" class="btn btn-outline-primary rounded-pill">
                            Ir a Inventario
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <!-- Citas -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-2">Citas</h5>
                        <p class="text-muted mb-3">
                            Consulte, confirme o reprograme las citas de los pacientes.
                        </p>
                    </div>
                    <div class="d-grid">
                        <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-primary rounded-pill">
                            Ver Citas
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pacientes / Reportes -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-2">Pacientes y Reportes</h5>
                        <p class="text-muted mb-3">
                            Acceda rápidamente a la lista de pacientes y revise reportes básicos de atención.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Pacientes" asp-action="Index" class="btn btn-outline-secondary flex-fill rounded-pill">
                            Ver Pacientes
                        </a>
                        <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-secondary flex-fill rounded-pill">
                            Ver Reportes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

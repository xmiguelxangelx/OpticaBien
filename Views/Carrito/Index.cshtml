@model List<Optica1.Models.CarritoItemViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Mi carrito";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-3">Mi carrito</h2>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Tu carrito está vacío.
        </div>

        <a asp-controller="CatalogoCliente" asp-action="Index" class="btn btn-primary">
            Ir al catálogo
        </a>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td class="text-end">$@item.Precio</td>
                        <td class="text-center">@item.Cantidad</td>
                        <td class="text-end">$@(item.Precio* item.Cantidad)</td>
                        <td class="text-center">
                            <a asp-controller="Carrito"
                               asp-action="Quitar"
                               asp-route-idProducto="@item.IdProducto"
                               class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h4>
                Total: $
                @Model.Sum(x => x.Precio * x.Cantidad)
            </h4>
        </div>

        <div class="text-end mt-3">
            <a asp-controller="Compra"
               asp-action="CrearDesdeCarrito"
               class="btn btn-success">
                Finalizar compra
            </a>
        </div>
    }
</div>

@model IEnumerable<Optica1.Models.Persona>
@using Optica1.Models

@{
    ViewData["Title"] = "Lista de Clientes";
    var perfiles = ViewBag.Perfiles as IEnumerable<Perfil>;
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Lista de Clientes</h2>

    <!-- BUSCADOR -->
    <form asp-action="Lista" method="get" class="d-flex justify-content-between mb-3">
        <div class="input-group" style="max-width: 450px;">
            <input type="text"
                   name="buscar"
                   value="@ViewData["BuscarActual"]"
                   class="form-control"
                   placeholder="Buscar por nombre, documento, usuario o correo" />
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
            <a asp-action="Lista" class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>

        <div class="btn-group">
            @if (User.IsInRole("administrador"))
            {
                <a asp-action="Nuevo" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Crear
                </a>
                <a asp-action="ExportarExcel" class="btn btn-outline-primary">
                    <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                </a>
                <a asp-action="Inactivos" class="btn btn-outline-secondary">
                    Ver inactivos
                </a>
            }
        </div>
    </form>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light text-center">
            <tr>
                <th style="width: 10%;">Cédula</th>
                <th style="width: 30%;">Nombre completo</th>
                <th style="width: 25%;">Correo</th>
                <th style="width: 15%;">Rol</th>
                <th style="width: 20%;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var persona in Model)
            {
                // Usuario activo asociado a la persona
                var usuarioActivo = persona.Usuarios
                .FirstOrDefault(u => u.Estado == "Activo");

                int? idPerfilActual = usuarioActivo?
                .UsuarioPerfils?
                .FirstOrDefault()?
                .IdPerfil;

                // Nombre del rol actual (para vista de solo lectura)
                string rolNombre = "Sin rol";
                if (idPerfilActual.HasValue && perfiles != null)
                {
                    var perfilActual = perfiles.FirstOrDefault(p => p.IdPerfil == idPerfilActual.Value);
                    if (perfilActual != null)
                    {
                        rolNombre = perfilActual.Descripcion;
                    }
                }

                <tr>
                    <td>@persona.IdPersona</td>
                    <td>
                        @persona.PrimerNombre @persona.SegundoNombre
                        @persona.PrimerApellido @persona.SegundoApellido
                    </td>
                    <td>@persona.Correo</td>

                    <!-- Columna Rol -->
                    <td class="text-center">
                        @if (User.IsInRole("administrador") && perfiles != null && usuarioActivo != null)
                        {
                            <form asp-action="CambiarRol"
                                  method="post"
                                  class="d-flex justify-content-center align-items-center gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idPersona" value="@persona.IdPersona" />

                                <select name="idPerfil"
                                        class="form-select form-select-sm"
                                        style="max-width: 150px;">
                                    @foreach (var perfil in perfiles)
                                    {
                                        <option value="@perfil.IdPerfil"
                                                selected="@(perfil.IdPerfil == idPerfilActual)">
                                            @perfil.Descripcion
                                        </option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-success btn-sm" title="Guardar rol">
                                    <i class="bi bi-check"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <span>@rolNombre</span>
                        }
                    </td>

                    <!-- Acciones -->
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <!-- Ver detalle (modal): todos los roles -->
                            <button type="button"
                                    class="btn btn-info btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalDetalle_@persona.IdPersona"
                                    title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </button>

                            <!-- Editar datos básicos: admin y empleado -->
                            @if (User.IsInRole("administrador") || User.IsInRole("empleado"))
                            {
                                <a asp-action="Editar"
                                   asp-route-id="@persona.IdPersona"
                                   class="btn btn-primary btn-sm"
                                   title="Editar datos básicos">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            }

                            <!-- Inactivar: solo administrador -->
                            @if (User.IsInRole("administrador"))
                            {
                                <a asp-action="Inactivar"
                                   asp-route-id="@persona.IdPersona"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('¿Seguro que deseas inactivar este cliente?');"
                                   title="Inactivar">
                                    <i class="bi bi-person-dash"></i>
                                </a>
                            }
                        </div>
                    </td>
                </tr>

                <!-- Modal de detalle por cliente -->
                <div class="modal fade" id="modalDetalle_@persona.IdPersona" tabindex="-1" aria-labelledby="labelDetalle_@persona.IdPersona" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="labelDetalle_@persona.IdPersona">
                                    Detalle del cliente @persona.PrimerNombre @persona.PrimerApellido
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong>Cédula:</strong> @persona.IdPersona
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Fecha de nacimiento:</strong> @persona.FechaNacimiento?.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong>Nombres:</strong> @persona.PrimerNombre @persona.SegundoNombre
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Apellidos:</strong> @persona.PrimerApellido @persona.SegundoApellido
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <strong>Correo:</strong> @persona.Correo
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Teléfono:</strong> @persona.Telefono
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <div class="col-md-12">
                                        <strong>Dirección:</strong> @persona.Direccion
                                    </div>
                                </div>

                                <hr />

                                <h6 class="mb-2">Datos de acceso</h6>
                                @if (usuarioActivo != null)
                                {
                                    <div class="row mb-1">
                                        <div class="col-md-6">
                                            <strong>Usuario:</strong> @usuarioActivo.NombreUsuario
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Contraseña:</strong> <span class="text-muted">Oculta por seguridad</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0">
                                        Este cliente aún no tiene usuario asociado.
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Cerrar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
</div>

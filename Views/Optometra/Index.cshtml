@model Optica1.Models.OptometraDashboardViewModel
@{
    ViewData["Title"] = "Panel del Optómetra";
}

<div class="container py-4">

    <!-- Encabezado tipo cliente -->
    <div class="mb-4">
        <h2 class="fw-bold">
            Hola Optómetra @Model.NombreOptometra 👓
        </h2>
        <p class="text-muted mb-1">
            Desde aquí puedes gestionar tus citas del día, revisar historias clínicas y consultar a tus pacientes.
        </p>
        <p class="text-muted">
            Gestión clínica diaria · @Model.FechaHoy.ToString("dd/MM/yyyy")
        </p>
    </div>

    <!-- Resumen numérico -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-1">Citas de hoy</h6>
                    <h3 class="fw-bold">@Model.TotalCitasHoy</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-1">Citas pendientes</h6>
                    <h3 class="fw-bold">@Model.CitasPendientes</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-1">Pacientes atendidos hoy</h6>
                    <h3 class="fw-bold">@Model.PacientesAtendidosHoy</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-1">Historias clínicas hoy</h6>
                    <h3 class="fw-bold">@Model.HistoriasClinicasHoy</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos principales -->
    <div class="row g-3">
        <!-- Gestión de Citas -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold mb-2">Agenda de Citas</h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consulte y gestione sus citas del día. Acceda rápidamente a cada paciente y su historia clínica.
                    </p>
                    <a asp-controller="Cita" asp-action="Index" class="btn btn-primary mt-auto">
                        Ir a Citas
                    </a>
                </div>
            </div>
        </div>

        <!-- Historias Clínicas -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold mb-2">Historias Clínicas</h5>
                    <p class="card-text text-muted flex-grow-1">
                        Acceda al historial clínico de sus pacientes, registre diagnósticos y fórmulas ópticas.
                    </p>
                    <a asp-controller="Historiaclinica" asp-action="Index" class="btn btn-outline-primary mt-auto">
                        Ir a Historias Clínicas
                    </a>
                </div>
            </div>
        </div>

        <!-- Pacientes -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold mb-2">Pacientes</h5>
                    <p class="card-text text-muted flex-grow-1">
                        Consulte los datos de sus pacientes del día, su horario de cita y motivo de consulta.
                    </p>
                    <a asp-controller="Optometra" asp-action="MisPacientes" class="btn btn-outline-secondary mt-auto">
                        Ver Pacientes del día
                    </a>
                </div>
            </div>
        </div>



        <!-- Reportes Clínicos -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold mb-2">Reportes Clínicos</h5>
                    <p class="card-text text-muted flex-grow-1">
                        Revise rápidamente su productividad diaria: citas atendidas, canceladas y pendientes.
                    </p>
                    <a asp-controller="Cita" asp-action="Index" class="btn btn-outline-secondary mt-auto">
                        Ver Reportes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

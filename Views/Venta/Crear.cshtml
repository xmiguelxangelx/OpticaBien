@{
    ViewData["Title"] = "Registrar venta";
}

<h2 class="mt-3">Registrar nueva venta</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Crear" method="post">
    <div class="mb-3">
        <label class="form-label">Fecha de venta</label>
        <input type="date" name="fecha" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de entrega (opcional)</label>
        <input type="date" name="fechaEntrega" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <select name="idUsuariopaciente" class="form-control" asp-items="ViewBag.Clientes" required>
            <option value="">-- Seleccione un cliente --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Total</label>
        <input type="number" step="0.01" name="total" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Abono</label>
        <input type="number" step="0.01" name="abono" class="form-control" value="0" />
        <small class="text-muted">El abono no puede ser mayor que el total.</small>
    </div>

    <hr />

    <h4>Productos vendidos</h4>

    <div id="productos-lista">
        <div class="producto-item mb-3">
            <select name="productoId" class="form-control mb-2" asp-items="ViewBag.Productos">
                <option value="">Seleccione un producto</option>
            </select>

            <input name="cantidad" class="form-control" type="number" min="1"
                   placeholder="Cantidad" />
        </div>
    </div>

    <button type="button" class="btn btn-secondary" onclick="agregarProducto()">Agregar otro producto</button>

    <br /><br />

    <button type="submit" class="btn btn-success">Guardar venta</button>
</form>

<script>
    function agregarProducto() {
        const container = document.getElementById("productos-lista");
        const nuevo = container.children[0].cloneNode(true);
        container.appendChild(nuevo);
    }
</script>

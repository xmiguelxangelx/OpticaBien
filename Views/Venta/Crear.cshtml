@{
    ViewData["Title"] = "Registrar nueva venta";
}

<h2 class="mt-3">Registrar nueva venta</h2>

@if (TempData["ErrorVenta"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorVenta"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<form asp-action="Crear" method="post" class="mt-4">

    <!-- ============================
         DATOS GENERALES DE LA VENTA
    ============================= -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Fecha de venta</label>
            <input type="date" name="fecha" class="form-control"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
        </div>

        <div class="col-md-4">
            <label class="form-label">Fecha de entrega (opcional)</label>
            <input type="date" name="fechaEntrega" class="form-control" />
        </div>
    </div>

    <!-- ============================
         CLIENTE POR DOCUMENTO
    ============================= -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Cliente</h5>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">Documento del cliente</label>
                    <div class="input-group">
                        <input type="text" id="DocumentoCliente" class="form-control" placeholder="Número de documento" />
                        <button type="button" class="btn btn-outline-primary" onclick="buscarCliente()">
                            Buscar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Hidden real que se envía al POST -->
            <input type="hidden" id="IdUsuariopaciente" name="idUsuariopaciente" />

            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Nombre completo</label>
                    <input type="text" id="NombreCliente" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Correo</label>
                    <input type="text" id="CorreoCliente" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Teléfono</label>
                    <input type="text" id="TelefonoCliente" class="form-control" readonly />
                </div>
            </div>
        </div>
    </div>

    <!-- ============================
         TOTAL Y ABONO
    ============================= -->
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label">Total</label>
            <!-- se calcula automáticamente -->
            <input type="number" id="TotalVenta" name="total" class="form-control"
                   min="0" step="0.01" required readonly />
        </div>
        <div class="col-md-4">
            <label class="form-label">Abono</label>
            <input type="number" name="abono" class="form-control" min="0" step="0.01" value="0" />
            <small class="text-muted">El abono no puede ser mayor que el total.</small>
        </div>
    </div>

    <!-- ============================
         PRODUCTOS POR CÓDIGO
    ============================= -->
    <h5>Productos vendidos</h5>

    <div id="productosContainer">

        <div class="fila-producto mb-3">
            <div class="row align-items-end">

                <!-- Código producto -->
                <div class="col-md-3">
                    <label class="form-label">Código producto</label>
                    <div class="input-group">
                        <input type="text" class="form-control codigo-input" placeholder="Código" />
                        <button type="button" class="btn btn-outline-secondary" onclick="buscarProducto(this)">
                            Buscar
                        </button>
                    </div>
                </div>

                <!-- Nombre -->
                <div class="col-md-3">
                    <label class="form-label">Nombre producto</label>
                    <input type="text" class="form-control nombre-producto" readonly />
                </div>

                <!-- Cantidad -->
                <div class="col-md-2">
                    <label class="form-label">Cantidad</label>
                    <input type="number" name="cantidad" class="form-control cantidad-input"
                           min="1" value="1" oninput="recalcularLinea(this)" />
                </div>

                <!-- Precio unitario -->
                <div class="col-md-2">
                    <label class="form-label">Precio unitario</label>
                    <input type="number" class="form-control precio-input"
                           step="0.01" readonly />
                </div>

                <!-- Total línea -->
                <div class="col-md-2">
                    <label class="form-label">Total línea</label>
                    <input type="number" class="form-control total-linea-input"
                           step="0.01" readonly />
                </div>

                <!-- hidden que se envía al POST -->
                <input type="hidden" name="productoId" class="id-producto" />
            </div>

            <div class="row mt-2">
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-danger" onclick="eliminarFila(this)">
                        Quitar
                    </button>
                </div>
            </div>
        </div>

    </div>

    <button type="button" class="btn btn-outline-success mb-4" onclick="agregarProducto()">
        Agregar otro producto
    </button>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Guardar venta</button>
        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
    </div>

</form>

@section Scripts {
    <script>
        // ============================
        // BUSCAR CLIENTE POR DOCUMENTO
        // ============================
        async function buscarCliente() {
            const doc = document.getElementById("DocumentoCliente").value.trim();
            if (!doc) {
                alert("Ingrese el número de documento del cliente.");
                return;
            }

            const url = '@Url.Action("BuscarClientePorDocumento", "Venta")'
                       + '?documento=' + encodeURIComponent(doc);

            const resp = await fetch(url);
            if (!resp.ok) {
                alert("Error consultando el cliente.");
                return;
            }

            const data = await resp.json();
            if (!data.encontrado) {
                alert("Cliente no encontrado.");
                document.getElementById("IdUsuariopaciente").value = "";
                document.getElementById("NombreCliente").value = "";
                document.getElementById("CorreoCliente").value = "";
                document.getElementById("TelefonoCliente").value = "";
                return;
            }

            document.getElementById("IdUsuariopaciente").value = data.idUsuario;
            document.getElementById("NombreCliente").value = data.nombreCompleto;
            document.getElementById("CorreoCliente").value = data.correo;
            document.getElementById("TelefonoCliente").value = data.telefono;
        }

        // ============================
        // PRODUCTOS
        // ============================
        async function buscarProducto(btn) {
            const fila = btn.closest(".fila-producto");
            const codigoInput = fila.querySelector(".codigo-input");
            const nombreInput = fila.querySelector(".nombre-producto");
            const idProductoInput = fila.querySelector(".id-producto");
            const precioInput = fila.querySelector(".precio-input");
            const cantidadInput = fila.querySelector(".cantidad-input");
            const totalLineaInput = fila.querySelector(".total-linea-input");

            const codigo = codigoInput.value.trim();
            if (!codigo) {
                alert("Ingrese el código del producto.");
                return;
            }

            const url = '@Url.Action("BuscarProductoPorCodigo", "Venta")'
                       + '?codigo=' + encodeURIComponent(codigo);

            const resp = await fetch(url);
            if (!resp.ok) {
                alert("Error consultando producto.");
                return;
            }

            const data = await resp.json();

            if (!data.encontrado) {
                alert("Producto no encontrado.");
                nombreInput.value = "";
                idProductoInput.value = "";
                precioInput.value = "";
                totalLineaInput.value = "";
                recalcularTotalGeneral();
                return;
            }

            // llenar datos
            nombreInput.value = data.nombre;
            idProductoInput.value = data.idProducto;
            precioInput.value = data.precio;

            // recalcular total de la línea y general
            recalcularLinea(cantidadInput);
        }

        // Calcula el total de UNA fila
        function recalcularLinea(cantidadElement) {
            const fila = cantidadElement.closest(".fila-producto");
            const cantidad = parseFloat(fila.querySelector(".cantidad-input").value) || 0;
            const precio = parseFloat(fila.querySelector(".precio-input").value) || 0;
            const totalLinea = cantidad * precio;

            const totalLineaInput = fila.querySelector(".total-linea-input");
            totalLineaInput.value = totalLinea ? totalLinea.toFixed(2) : "";

            recalcularTotalGeneral();
        }

        // Suma todas las filas y actualiza el total de la venta
        function recalcularTotalGeneral() {
            const totalInputs = document.querySelectorAll(".total-linea-input");
            let suma = 0;

            totalInputs.forEach(inp => {
                const val = parseFloat(inp.value);
                if (!isNaN(val)) {
                    suma += val;
                }
            });

            const totalVenta = document.getElementById("TotalVenta");
            totalVenta.value = suma ? suma.toFixed(2) : "";
        }

        // Clona la primera fila de producto
        function agregarProducto() {
            const cont = document.getElementById("productosContainer");
            const primera = cont.querySelector(".fila-producto");
            const nueva = primera.cloneNode(true);

            nueva.querySelector(".codigo-input").value = "";
            nueva.querySelector(".nombre-producto").value = "";
            nueva.querySelector(".id-producto").value = "";
            nueva.querySelector(".precio-input").value = "";
            nueva.querySelector(".total-linea-input").value = "";
            nueva.querySelector(".cantidad-input").value = 1;

            cont.appendChild(nueva);
        }

        // Elimina una fila de producto
        function eliminarFila(btn) {
            const cont = document.getElementById("productosContainer");
            const filas = cont.querySelectorAll(".fila-producto");
            if (filas.length === 1) {
                alert("Debe haber al menos un producto en la venta.");
                return;
            }
            btn.closest(".fila-producto").remove();
            recalcularTotalGeneral();
        }
    </script>
}

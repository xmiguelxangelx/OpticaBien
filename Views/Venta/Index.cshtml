@model IEnumerable<Optica1.Models.Ventum>

@{
    // Diccionario: IdVenta -> TotalAbonado (desde VentaPago)
    var abonosDict = ViewBag.TotalAbonadoPorVenta
        as IDictionary<int, float>;
}

@* Filtro por ID de venta *@
<form asp-action="Index" method="get" class="row g-3 mb-3">
    <div class="col-md-3">
        <label class="form-label">Buscar por ID de venta</label>
        <div class="input-group">
            <input type="number" name="idBusqueda" class="form-control"
                   min="1" value="@ViewBag.IdBusqueda" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>


<h2 class="mt-3">Ventas registradas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-bordered table-striped mt-4">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Empleado</th>
            <th>Total</th>
            <th>Abonado</th>      @* total abonado real *@
            <th>Saldo</th>
            <th>Fecha entrega</th>
           
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venta in Model)
        {
            float total = venta.Total ?? 0;

            float totalAbonado = 0;
            if (abonosDict != null && abonosDict.ContainsKey(venta.IdVenta))
            {
                totalAbonado = abonosDict[venta.IdVenta];
            }

            // saldo real = total - lo abonado en venta_pago
            var saldo = total - totalAbonado;

            <tr>
                <td>@venta.IdVenta</td>
                <td>@venta.Fecha</td>
                <td>@venta.IdUsuariopacienteNavigation?.NombreUsuario</td>
                <td>@venta.IdUsuarioempleadoNavigation?.NombreUsuario</td>
                <td>@total</td>
                <td>@totalAbonado</td>
                <td>@saldo</td>
                <td>@venta.FechaEntrega</td>
                
                <td>
                    <a asp-action="Pagos" asp-route-id="@venta.IdVenta"
                       class="btn btn-info btn-sm">Abonar / Ver pagos</a>

                    <a asp-action="Editar" asp-route-id="@venta.IdVenta"
                       class="btn btn-warning btn-sm">Editar</a>

                    <form asp-action="Cancelar" asp-route-id="@venta.IdVenta"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('¿Seguro que deseas cancelar esta venta?');">
                            Cancelar
                        </button>
                    </form>


                </td>

            </tr>
        }
    </tbody>
</table>

<a asp-action="Crear" class="btn btn-primary">Registrar nueva venta</a>

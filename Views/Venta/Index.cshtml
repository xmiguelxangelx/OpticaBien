@model IEnumerable<Optica1.Models.Ventum>

@{
    // Diccionario: IdVenta -> TotalAbonado (desde VentaPago)
    var abonosDict = ViewBag.TotalAbonadoPorVenta
        as IDictionary<int, float>;
}

<h2 class="mt-3">Ventas registradas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-bordered table-striped mt-4">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Empleado</th>
            <th>Total</th>
            <th>Abonado</th>      @* total abonado real *@
            <th>Saldo</th>
            <th>Fecha entrega</th>
            <th>Productos</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var venta in Model)
        {
            float total = venta.Total ?? 0;

            float totalAbonado = 0;
            if (abonosDict != null && abonosDict.ContainsKey(venta.IdVenta))
            {
                totalAbonado = abonosDict[venta.IdVenta];
            }

            // saldo real = total - lo abonado en venta_pago
            var saldo = total - totalAbonado;

            <tr>
                <td>@venta.IdVenta</td>
                <td>@venta.Fecha</td>
                <td>@venta.IdUsuariopacienteNavigation?.NombreUsuario</td>
                <td>@venta.IdUsuarioempleadoNavigation?.NombreUsuario</td>
                <td>@total</td>
                <td>@totalAbonado</td>
                <td>@saldo</td>
                <td>@venta.FechaEntrega</td>
                <td>
                    <ul>
                        @foreach (var item in venta.ProductoVenta)
                        {
                            <li>
                                @item.IdProductoNavigation?.Nombre — <strong>@item.Cantidad</strong>
                            </li>
                        }
                    </ul>
                </td>
                <td>
                    <a asp-controller="VentaPago"
                       asp-action="Index"
                       asp-route-idVenta="@venta.IdVenta"
                       class="btn btn-sm btn-outline-info mb-1">
                        Ver pagos
                    </a>

                    <a asp-action="Editar"
                       asp-route-id="@venta.IdVenta"
                       class="btn btn-sm btn-outline-primary mb-1">
                        Editar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@venta.IdVenta"
                       class="btn btn-sm btn-outline-danger"
                       onclick="return confirm('¿Eliminar esta venta?');">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Crear" class="btn btn-primary">Registrar nueva venta</a>

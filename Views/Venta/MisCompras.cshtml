@model IEnumerable<Optica1.Models.MisCompraViewModel>

@{
    ViewData["Title"] = "Mis compras";
}

<div class="container mt-4">
    <h2 class="mb-3">Mis compras</h2>

    @if (!Model.Any())
    {
        <p class="text-muted">Aún no tienes compras registradas.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Abonado</th>
                    <th>Saldo</th>
                    <th>Empleado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@(m.Venta.Fecha?.ToString("yyyy-MM-dd") ?? "")</td>
                        <td>@m.Total</td>
                        <td>@m.Abonado</td>
                        <td>@m.Saldo</td>
                        <td>@m.Venta.IdUsuarioempleadoNavigation?.NombreUsuario</td>
                        <td>
                            <a asp-controller="Venta" asp-action="Pagos" asp-route-id="@m.Venta.IdVenta"
                               class="btn btn-sm btn-outline-primary">
                                Ver abonos
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Cliente" asp-action="Index" class="btn btn-secondary">
        Volver al panel
    </a>
</div>

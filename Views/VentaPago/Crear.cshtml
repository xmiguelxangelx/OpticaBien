@model Optica1.Models.VentaPago

@{
    ViewData["Title"] = "Registrar abono";
}

<h2 class="mt-3">Registrar abono</h2>

<form method="post">
    <input type="hidden" asp-for="IdVenta" value="@ViewBag.IdVenta" />

    <div class="mb-3">
        <label class="form-label">Monto del abono</label>
        <input asp-for="Monto" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Medio de pago</label>
        <select asp-for="IdMedioDePago" class="form-control">
            <option value="">Seleccione</option>
            @foreach (var mp in ViewBag.MediosPago)
            {
                <option value="@mp.IdMedioDePago">@mp.Descripcion</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success">Guardar abono</button>
    <a asp-action="Index" asp-route-idVenta="@ViewBag.IdVenta" class="btn btn-secondary ms-2">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model Optica1.Models.Producto

@{
    ViewData["Title"] = "Detalle del producto";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-link mb-3">&laquo; Volver al catálogo</a>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h3 class="fw-bold mb-3">@Model.Nombre</h3>

            @if (!string.IsNullOrWhiteSpace(Model.Marca))
            {
                <p><strong>Marca:</strong> @Model.Marca</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Tipo))
            {
                <p><strong>Tipo:</strong> @Model.Tipo</p>
            }

            <p><strong>Precio:</strong> $@Model.Precio</p>

            <p><strong>Stock disponible:</strong> @(Model.Stock ?? 0)</p>

            @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
            {
                <p class="mt-3">@Model.Descripcion</p>
            }

            <div class="mt-4 d-flex gap-2">
                <a asp-controller="Carrito"
                   asp-action="Agregar"
                   asp-route-idProducto="@Model.IdProducto"
                   class="btn btn-primary">
                    Añadir al carrito
                </a>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>

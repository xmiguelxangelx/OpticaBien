@model IEnumerable<Optica1.Models.VwVentasDetallada>

@{
    ViewData["Title"] = "Reporte de ventas";
    var desde = ViewBag.Desde as string;
    var hasta = ViewBag.Hasta as string;
}

<h2 class="mt-3">Reporte de ventas detalladas</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">Desde</label>
        <input type="date" name="desde" value="@desde" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Hasta</label>
        <input type="date" name="hasta" value="@hasta" class="form-control" />
    </div>
    <div class="col-md-6 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        <button type="submit" name="exportar" value="true" class="btn btn-success">
            Exportar a Excel
        </button>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            Volver al panel
        </a>
    </div>
</form>

<table class="table table-bordered table-striped table-sm">
    <thead class="table-light">
        <tr>
            <th>ID Venta</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Empleado</th>
            <th>Producto</th>
            <th>Cant.</th>
            <th>Precio</th>
            <th>Subtotal</th>
            <th>Abono</th>
            <th>Total</th>
            <th>Fecha entrega</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.IdVenta</td>
                <td>@v.Fecha</td>
                <td>@v.NombreCliente @v.ApellidoCliente</td>
                <td>@v.NombreEmpleado @v.ApellidoEmpleado</td>
                <td>@v.Producto</td>
                <td>@v.Cantidad</td>
                <td>@v.Precio</td>
                <td>@v.Subtotal</td>
                <td>@v.Abono</td>
                <td>@v.Total</td>
                <td>@v.FechaEntrega</td>
            </tr>
        }
    </tbody>
</table>

@model Optica1.Models.Historiaclinica

@{
    ViewData["Title"] = "Nueva historia clínica";
}

<h2>Nueva historia clínica</h2>

<form asp-action="Crear" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="FechaCreacion" class="form-label">Fecha</label>
            <input asp-for="FechaCreacion" class="form-control" type="date" />
            <span asp-validation-for="FechaCreacion" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">Documento paciente</label>
            <div class="input-group">
                <input type="text" id="DocumentoPaciente" class="form-control" />
                <button type="button" class="btn btn-secondary" id="btnBuscarPaciente">
                    Buscar
                </button>
            </div>

            <!-- Aquí guardamos el IdUsuarioPaciente que se usará al guardar -->
            <input type="hidden" asp-for="IdUsuarioPaciente" id="IdUsuarioPaciente" />
            <span asp-validation-for="IdUsuarioPaciente" class="text-danger"></span>

            <!-- Panel con los datos básicos del paciente -->
            <div class="mt-2 border rounded p-2 bg-light" id="PacienteDatos" style="display:none">
                <strong>Nombre:</strong> <span id="pacienteNombre"></span><br />
                <strong>Teléfono:</strong> <span id="pacienteTelefono"></span><br />
                <strong>Correo:</strong> <span id="pacienteCorreo"></span><br />
            </div>
        </div>

        <div class="col-md-4">
            <label asp-for="IdUsuarioOptometra" class="form-label">Optómetra</label>
            <select asp-for="IdUsuarioOptometra"
                    asp-items="(SelectList)ViewBag.Optometras"
                    class="form-control">
                <option value="">-- Seleccione optómetra --</option>
            </select>
            <span asp-validation-for="IdUsuarioOptometra" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="MotivoConsulta" class="form-label">Motivo de consulta</label>
        <textarea asp-for="MotivoConsulta" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MotivoConsulta" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Antecedentes" class="form-label">Antecedentes</label>
        <textarea asp-for="Antecedentes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Antecedentes" class="text-danger"></span>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="AgudezaVisualOd" class="form-label">Agudeza visual OD</label>
            <input asp-for="AgudezaVisualOd" class="form-control" />
            <span asp-validation-for="AgudezaVisualOd" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AgudezaVisualOi" class="form-label">Agudeza visual OI</label>
            <input asp-for="AgudezaVisualOi" class="form-control" />
            <span asp-validation-for="AgudezaVisualOi" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="RxFinalOd" class="form-label">Rx final OD</label>
            <input asp-for="RxFinalOd" class="form-control" />
            <span asp-validation-for="RxFinalOd" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="RxFinalOi" class="form-label">Rx final OI</label>
            <input asp-for="RxFinalOi" class="form-control" />
            <span asp-validation-for="RxFinalOi" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Observaciones" class="form-label">Observaciones / Recomendaciones</label>
        <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(function () {
            $('#btnBuscarPaciente').on('click', function () {
                var doc = $('#DocumentoPaciente').val();

                if (!doc) {
                    alert('Por favor ingresa el documento del paciente.');
                    return;
                }

                $.getJSON('@Url.Action("BuscarPaciente", "Historiaclinica")', { documento: doc })
                    .done(function (data) {
                        if (data.encontrado) {
                            $('#IdUsuarioPaciente').val(data.idUsuario);
                            $('#pacienteNombre').text(data.nombre);
                            $('#pacienteTelefono').text(data.telefono || '');
                            $('#pacienteCorreo').text(data.correo || '');
                            $('#PacienteDatos').show();
                        } else {
                            $('#IdUsuarioPaciente').val('');
                            $('#PacienteDatos').hide();
                            alert(data.mensaje);
                        }
                    })
                    .fail(function () {
                        alert('Ocurrió un error al buscar el paciente.');
                    });
            });
        });
    </script>
}


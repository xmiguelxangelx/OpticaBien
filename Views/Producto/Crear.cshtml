@model Optica1.Models.Producto

@{
    ViewData["Title"] = "Nuevo producto";
}

<h2 class="mt-3">Registrar nuevo producto</h2>

<form asp-action="Crear" method="post">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <input asp-for="Tipo" class="form-control" placeholder="Montura, lente, líquido, accesorio..." />
    </div>

    <div class="mb-3">
        <label class="form-label">Marca</label>
        <input asp-for="Marca" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Proveedor principal</label>
        <select asp-for="IdProveedorNit" class="form-control" asp-items="ViewBag.Proveedores">
            <option value="">-- Seleccione un proveedor --</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Precio</label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label class="form-label">Stock inicial</label>
        <input asp-for="Stock" class="form-control" type="number" min="0" />
    </div>

    <div class="mb-3">
        <label class="form-label">Stock mínimo</label>
        <input asp-for="StockMinimo" class="form-control" type="number" min="0" />
        <small class="text-muted">Se resaltará en amarillo cuando el stock actual sea menor o igual a este valor.</small>
    </div>

    <button type="submit" class="btn btn-success">Guardar producto</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
</form>

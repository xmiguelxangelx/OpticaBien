@model IEnumerable<Optica1.Models.Producto>

@{
    ViewData["Title"] = "Inventario de productos";
}

<h2 class="mt-3">Inventario de productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Crear" class="btn btn-primary mb-3">Nuevo producto</a>
<a asp-action="Inactivos" class="btn btn-outline-secondary mb-3 ms-2">Ver inactivos</a>
<a asp-action="ExportarInventario" class="btn btn-success mb-3 ms-2">Exportar a Excel</a>


<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Stock mínimo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.IdProducto</td>       
                <td>@p.Nombre</td>
                <td>@p.Tipo</td>
                <td>@p.Marca</td>
                <td>@p.IdProveedorNitNavigation?.Nombre</td>
                <td>@p.Precio</td>
                <td>@(p.Stock ?? 0)</td>
                <td>@(p.StockMinimo ?? 0)</td>
                <td>@(string.IsNullOrEmpty(p.Estado) ? "activo" : p.Estado)</td>
                <td> ... botones ... </td>
            </tr>
        }
    </tbody>

</table>

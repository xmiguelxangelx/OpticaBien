@model IEnumerable<Optica1.Models.Producto>

@{
    ViewData["Title"] = "Inventario de productos";
}

<h2 class="mt-3">Inventario de productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Mensaje"]</div>
}

<div class="mb-3 mt-3 d-flex gap-2">
    <a asp-action="Crear" class="btn btn-primary">
        Nuevo producto
    </a>

    @if (User.IsInRole("administrador"))
    {
        <a asp-action="Inactivos" class="btn btn-outline-secondary">
            Ver inactivos
        </a>

        <a asp-action="ExportarInventario" class="btn btn-outline-success">
            Exportar a Excel
        </a>
    }
</div>

<table class="table table-striped table-hover mt-2">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Stock mín.</th>
            <th>Proveedor</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            bool alertaStock = item.Stock.HasValue && item.StockMinimo.HasValue &&
            item.Stock <= item.StockMinimo;

            <tr class="@(alertaStock ? "table-warning" : "")">
                <td>@item.IdProducto</td>
                <td>@item.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Marca</td>
                <td>@item.Precio</td>
                <td>@item.Stock</td>
                <td>@item.StockMinimo</td>
                <td>@item.IdProveedorNitNavigation?.Nombre</td>
                <td>
                    <!-- EDITAR: lo pueden ver admin y empleado -->
                    <a asp-action="Editar" asp-route-id="@item.IdProducto"
                       class="btn btn-sm btn-outline-primary">
                        Editar
                    </a>

                    <!-- INACTIVAR: solo ADMIN -->
                    @if (User.IsInRole("administrador"))
                    {
                        <a asp-action="Inactivar" asp-route-id="@item.IdProducto"
                           class="btn btn-sm btn-outline-danger ms-1"
                           onclick="return confirm('¿Desea inactivar este producto?');">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

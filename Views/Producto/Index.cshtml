@model IEnumerable<Optica1.Models.Producto>

<h2 class="mt-3">Inventario de productos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Proveedor</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdProducto</td>
                <td>@item.Nombre</td>
                <td>@item.Tipo</td>
                <td>@item.Marca</td>
                <td>@item.Precio</td>
                <td>@item.Stock</td>
                <td>@item.IdProveedorNitNavigation?.Nombre</td>

                <td>
                    <!-- EDITAR: lo pueden ver admin y empleado -->
                    <a asp-action="Editar" asp-route-id="@item.IdProducto"
                       class="btn btn-sm btn-outline-primary">
                        Editar
                    </a>

                    <!-- ELIMINAR / INACTIVAR: solo ADMIN -->
                    @if (User.IsInRole("administrador"))
                    {
                        <a asp-action="Inactivar" asp-route-id="@item.IdProducto"
                           class="btn btn-sm btn-outline-danger ms-1">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

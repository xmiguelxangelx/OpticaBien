@model IEnumerable<Optica1.Models.Producto>

@{
    ViewData["Title"] = "Productos inactivos";
}

<h2 class="mt-3">Productos inactivos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<a asp-action="Index" class="btn btn-primary mb-3">Volver al inventario</a>

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Marca</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Stock mínimo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            var stock = p.Stock ?? 0;
            var minimo = p.StockMinimo ?? 0;

            <tr>
                <td>@p.Nombre</td>
                <td>@p.Tipo</td>
                <td>@p.Marca</td>
                <td>@p.IdProveedorNitNavigation?.Nombre</td>
                <td>@p.Precio</td>
                <td>@stock</td>
                <td>@minimo</td>
                <td>@(string.IsNullOrEmpty(p.Estado) ? "Inactivo" : p.Estado)</td>
                <td>
                    <a asp-action="Activar" asp-route-id="@p.IdProducto"
                       class="btn btn-sm btn-outline-success"
                       onclick="return confirm('¿Activar este producto?');">
                        Activar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@model IEnumerable<Optica1.Models.Compra>

<h2 class="mt-3">Compras registradas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<table class="table table-bordered table-striped mt-4">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Proveedor</th>
            <th>Productos</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var compra in Model)
        {
            <tr>
                <td>@compra.IdCompra</td>
                <td>@compra.FechaCompra</td>

                <td>
                    @compra.ProveedorCompras
                    .FirstOrDefault()?.IdProveedorNitNavigation?.Nombre
                </td>

                <td>
                    <ul>
                        @foreach (var p in compra.ProductoCompras)
                        {
                            <li>
                                @p.IdProductoNavigation?.Nombre
                                — <strong>@p.Cantidad</strong>
                            </li>
                        }
                    </ul>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Crear" class="btn btn-primary">Registrar nueva compra</a>
